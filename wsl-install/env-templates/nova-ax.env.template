# ── nova-ax — WSL2 .env 템플릿 ────────────────────────────────────────────
# 사용: cp nova-ax.env.template <설치루트>/nova-ax/.env  후 <...> 교체
# nova-ax 저장소에는 .env.example 이 없으므로 이 템플릿이 유일한 기준이다.
# .env 는 nova-ax/.gitignore 에 등재돼 있어 커밋되지 않는다.

# ── 인증 ──────────────────────────────────────────────────────────────────
# AX_NCO_SECRET 은 nco 쪽과 값이 일치해야 상호 인증이 통과한다.
AX_API_TOKEN=<임의의_긴_랜덤_문자열>
AX_NCO_SECRET=<nco와_동일한_공유시크릿>

# ── nco 백엔드 연결 (같은 WSL 인스턴스에서 돌 때 기준) ─────────────────────
NCO_URL=http://127.0.0.1:6200
NCO_WS_URL=ws://127.0.0.1:6201

# ── 서버 ──────────────────────────────────────────────────────────────────
AX_PORT=6300
# 0.0.0.0 으로 두면 Windows 호스트 브라우저에서도 접근된다.
AX_HOST=0.0.0.0
AX_LOG_LEVEL=info
