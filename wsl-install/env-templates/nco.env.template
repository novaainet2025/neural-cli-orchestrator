# ── nco (Neural CLI Orchestrator) — WSL2 .env 템플릿 ──────────────────────
# 사용: cp nco.env.template <설치루트>/nco/.env  후 <...> 자리를 실제 값으로 교체
# 주의: 이 파일에는 실제 시크릿을 넣지 말 것. .env는 저장소 .gitignore에 등재돼 있음.
#
# 저장소의 .env.example 이 항상 최신 기준이다. install-wsl.sh 는 .env.example 이
# 있으면 그것을 우선 복사하고, 없을 때만 이 템플릿을 쓴다.

# ── 서버 ──────────────────────────────────────────────────────────────────
PORT=6200
WS_PORT=6201
NODE_ENV=production

# ── 저장소 경로 (WSL 네이티브 경로만 사용. /mnt/c 금지 — I/O가 극단적으로 느림) ──
DATABASE_PATH=./db/nco.db
STATE_FILE_PATH=./db/worker-state.json
PROJECT_DIR=/home/<WSL사용자명>/nova
OBSIDIAN_VAULT_PATH=

# ── Redis (bullmq 작업 큐가 필수로 요구) ──────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── 대시보드 ──────────────────────────────────────────────────────────────
DASHBOARD_URL=http://127.0.0.1:5173

# ── 인증 ──────────────────────────────────────────────────────────────────
NCO_API_TOKEN=<임의의_긴_랜덤_문자열>

# ── AI 프로바이더 키 (사용하는 것만 채우면 됨) ─────────────────────────────
ANTHROPIC_API_KEY=<sk-ant-...>
OPENAI_API_KEY=<sk-...>
GEMINI_API_KEYS=<키1,키2>
OPENROUTER_API_KEYS=<키1,키2>

# ── 로컬 LLM (Ollama 설치한 경우만) ───────────────────────────────────────
# WSL에서 Windows 호스트의 Ollama를 쓸 때는 127.0.0.1이 아니라 호스트 IP가 필요.
# 호스트 IP 확인: ip route show default | awk '{print $3}'
OLLAMA_HOST=http://127.0.0.1:11434

# ── 워커 튜닝 (기본값으로 시작하고, 필요할 때만 조정) ──────────────────────
WORKER_CONCURRENCY=2
WORKER_RATE_LIMIT_RPM=60
NCO_TASK_TIMEOUT_MS=600000
NCO_TASK_IDLE_TIMEOUT_MS=180000

# ── 알림 연동 (선택) ──────────────────────────────────────────────────────
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
